FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine AS build

ARG TARGETOS
ARG TARGETARCH
ARG RELEASE_VERSION=main
ARG SOURCE_REVISION=unknown

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags="-s -w -X github.com/dbpprt/dieter/internal/buildinfo.ReleaseVersion=$RELEASE_VERSION -X github.com/dbpprt/dieter/internal/buildinfo.SourceRevision=$SOURCE_REVISION" \
    -o /out/dieter-gateway ./cmd/dieter-gateway

FROM alpine:3.23
RUN apk add --no-cache ca-certificates \
    && addgroup -S dieter \
    && adduser -S -G dieter -h /var/lib/dieter-gateway dieter \
    && install -d -o dieter -g dieter -m 0700 /var/lib/dieter-gateway
COPY --from=build /out/dieter-gateway /usr/local/bin/dieter-gateway
USER dieter
VOLUME ["/var/lib/dieter-gateway"]
EXPOSE 4243
ENTRYPOINT ["/usr/local/bin/dieter-gateway"]
CMD ["--store", "/var/lib/dieter-gateway"]
