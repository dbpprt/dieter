FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine AS build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/nauclio-gateway ./cmd/nauclio-gateway

FROM alpine:3.23
RUN apk add --no-cache ca-certificates \
    && addgroup -S nauclio \
    && adduser -S -G nauclio -h /var/lib/nauclio-gateway nauclio \
    && install -d -o nauclio -g nauclio -m 0700 /var/lib/nauclio-gateway
COPY --from=build /out/nauclio-gateway /usr/local/bin/nauclio-gateway
USER nauclio
VOLUME ["/var/lib/nauclio-gateway"]
EXPOSE 4243
ENTRYPOINT ["/usr/local/bin/nauclio-gateway"]
CMD ["--store", "/var/lib/nauclio-gateway"]
