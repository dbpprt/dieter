{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dieter.local/schemas/e2e-v1.json",
  "title": "Dieter native test case v1",
  "description": "Editor assistance; just e2e lint is authoritative for source references, fixtures, durations, variables and native build compatibility.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,100}$"
    },
    "platform": {
      "enum": [
        "android",
        "ios"
      ]
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,100}$"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,100}$"
      }
    },
    "fixture": {
      "enum": [
        "none",
        "gateway",
        "activity",
        "screen"
      ]
    },
    "build": {
      "const": "performance"
    },
    "timeout": {
      "type": "string",
      "description": "Go duration between 1 second and 10 minutes; validated by just e2e lint"
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "class",
        "methods"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "launch": {
            "const": "connected"
          },
          "tap": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "oneOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "description"
                ]
              }
            ]
          },
          "type": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ],
            "oneOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "description"
                ]
              }
            ]
          },
          "press": {
            "const": "back"
          },
          "scroll": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "within": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [],
                "oneOf": [
                  {
                    "required": [
                      "id"
                    ]
                  },
                  {
                    "required": [
                      "text"
                    ]
                  },
                  {
                    "required": [
                      "description"
                    ]
                  }
                ]
              },
              "until": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [],
                "oneOf": [
                  {
                    "required": [
                      "id"
                    ]
                  },
                  {
                    "required": [
                      "text"
                    ]
                  },
                  {
                    "required": [
                      "description"
                    ]
                  }
                ]
              }
            },
            "required": [
              "within",
              "until"
            ]
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "enabled": {
                "type": "boolean"
              },
              "selected": {
                "type": "boolean"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [],
            "oneOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "description"
                ]
              }
            ],
            "anyOf": [
              {
                "required": [
                  "visible"
                ]
              },
              {
                "required": [
                  "enabled"
                ]
              },
              {
                "required": [
                  "selected"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          },
          "screenshot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,100}$"
          },
          "probe": {
            "const": "machine-telemetry"
          }
        },
        "required": [],
        "minProperties": 1,
        "maxProperties": 1
      }
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleSampleMillis": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,12}$"
        },
        "idleSampleWindows": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,12}$"
        },
        "dieterPerformanceFrames": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,12}$"
        },
        "screenLowLatency": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,12}$"
        },
        "screenSurface": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,12}$"
        },
        "screenDirectSurface": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,12}$"
        },
        "forceTURN": {
          "type": "string",
          "pattern": "^[0-9a-z]{1,12}$"
        }
      },
      "required": []
    }
  },
  "required": [
    "version",
    "id",
    "platform",
    "suites",
    "components",
    "fixture",
    "timeout"
  ],
  "oneOf": [
    {
      "required": [
        "native"
      ],
      "not": {
        "required": [
          "steps"
        ]
      }
    },
    {
      "required": [
        "steps"
      ],
      "not": {
        "required": [
          "native"
        ]
      }
    }
  ]
}
