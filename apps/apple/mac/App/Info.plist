<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key><string>Dieter</string>
    <key>CFBundleIconFile</key><string>DieterMonochrome</string>
    <key>ATSApplicationFontsPath</key><string>Fonts</string>
    <key>CFBundleURLTypes</key>
    <array><dict><key>CFBundleURLName</key><string>Dieter authentication</string><key>CFBundleURLSchemes</key><array><string>$(DIETER_MAC_URL_SCHEME)</string></array></dict></array>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>DieterReleaseVersion</key><string>$(DIETER_RELEASE_VERSION)</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
    <key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSHumanReadableCopyright</key><string>Dieter</string>
    <key>NSLocalNetworkUsageDescription</key><string>Dieter connects to a Dieter server on this Mac or a trusted private network.</string>
    <key>NSAppleEventsUsageDescription</key><string>Dieter reads the active browser tab URL when you capture a task, so you can include it with your screenshot.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSSupportsAutomaticTermination</key><false/>
    <key>NSSupportsSuddenTermination</key><false/>
</dict>
</plist>
