{
  "version": 1,
  "indentation": { "spaces": 4 },
  "lineLength": 120,
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": true,
  "reflowMultilineStringLiterals": "never",
  "rules": {
    "AlwaysUseLowerCamelCase": false,
    "DontRepeatTypeInStaticProperties": false,
    "UseSynthesizedInitializer": false
  }
}
