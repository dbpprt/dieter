<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_usage_row_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_widget_usage_row"
    android:paddingHorizontal="10dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_usage_row_provider" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/widget_title" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/widget_usage_row_percent" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_usage_row_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted"
        android:singleLine="true" android:ellipsize="end" android:layout_marginTop="1dp" />
    <ProgressBar android:id="@+id/widget_usage_row_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="5dp"
        android:progressDrawable="@drawable/widget_usage_bar" android:max="100" />
    <TextView android:id="@+id/widget_usage_row_reset" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_muted"
        android:singleLine="true" android:ellipsize="end" android:layout_marginTop="3dp" />
</LinearLayout>
