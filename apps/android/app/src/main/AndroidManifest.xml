<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DieterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_monochrome"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_monochrome_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dieter">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dieter-android" android:host="oauth" android:path="/callback" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".LauncherMonochrome"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_monochrome_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherElectricBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_electric_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_electric_blue_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherJadeOperator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_jade_operator"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_jade_operator_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCopperCircuit"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_copper_circuit"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_copper_circuit_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherUltravioletRelay"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ultraviolet_relay"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ultraviolet_relay_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherSolarCommand"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_solar_command"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_solar_command_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherArcticConsole"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_arctic_console"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_arctic_console_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCoralSignal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coral_signal"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_coral_signal_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".widget.DieterWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Dieter">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.DieterActivityWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_activity_info" />
        </receiver>
        <service
            android:name=".widget.DieterWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service
            android:name=".connection.DieterSyncService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging"
            android:stopWithTask="false" />
        <receiver
            android:name=".connection.NotificationDismissedReceiver"
            android:exported="false" />
        <receiver
            android:name=".connection.NotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".connection.DieterBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
