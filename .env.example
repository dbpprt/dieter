# Gateway configuration. Keep the real file at $NAUCLIO_GATEWAY_HOME/.env with
# mode 0600. Process environment values override this file.
NAUCLIO_GATEWAY_ADDR=127.0.0.1:4243
# Use proxy mode only behind an HTTPS reverse proxy on the same host.
NAUCLIO_GATEWAY_PROXY_MODE=1
NAUCLIO_PUBLIC_URL=https://nauclio.example.com
NAUCLIO_GITHUB_CLIENT_ID=
NAUCLIO_GITHUB_CLIENT_SECRET=
# Pin the immutable numeric ID; the login is display-only documentation.
NAUCLIO_GITHUB_ALLOWED_USER_ID=
NAUCLIO_GITHUB_ALLOWED_LOGIN=
# Generate with: openssl rand -hex 32
NAUCLIO_AUTH_SECRET=
NAUCLIO_NATIVE_SESSION_TTL=720h
# Exact custom-scheme callbacks used by the official native clients.
NAUCLIO_NATIVE_REDIRECT_URIS=nauclio-mac://oauth/callback,nauclio-android://oauth/callback
# If the gateway terminates TLS itself, disable proxy mode and provide both:
# NAUCLIO_GATEWAY_TLS_CERT=/path/to/fullchain.pem
# NAUCLIO_GATEWAY_TLS_KEY=/path/to/private-key.pem
