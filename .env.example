# Gateway configuration. Keep the real file at $DIETER_GATEWAY_HOME/.env with
# mode 0600. Process environment values override this file.
DIETER_GATEWAY_ADDR=127.0.0.1:4243
# Use proxy mode only behind an HTTPS reverse proxy on the same host.
DIETER_GATEWAY_PROXY_MODE=1
DIETER_PUBLIC_URL=https://dieter.example.com
DIETER_GITHUB_CLIENT_ID=
DIETER_GITHUB_CLIENT_SECRET=
# Pin the immutable numeric ID; the login is display-only documentation.
DIETER_GITHUB_ALLOWED_USER_ID=
DIETER_GITHUB_ALLOWED_LOGIN=
# Generate with: openssl rand -hex 32
DIETER_AUTH_SECRET=
DIETER_NATIVE_SESSION_TTL=720h
# Exact custom-scheme callbacks used by the official native clients.
DIETER_NATIVE_REDIRECT_URIS=dieter-mac://oauth/callback,dieter-android://oauth/callback
# Optional peer-to-peer screen sharing ICE configuration. TURN credentials are
# derived per daemon/operator and expire after DIETER_RTC_TTL.
DIETER_RTC_STUN_URLS=
DIETER_RTC_TURN_URLS=
DIETER_RTC_TTL=5m
# Generate with: openssl rand -hex 32
DIETER_RTC_TURN_SECRET=
# If the gateway terminates TLS itself, disable proxy mode and provide both:
# DIETER_GATEWAY_TLS_CERT=/path/to/fullchain.pem
# DIETER_GATEWAY_TLS_KEY=/path/to/private-key.pem
