# Gateway configuration. Keep the real file at $DIETER_GATEWAY_HOME/.env with
# mode 0600. Process environment values override this file.
DIETER_GATEWAY_ADDR=127.0.0.1:4243
# Use proxy mode only behind an HTTPS reverse proxy on the same host.
DIETER_GATEWAY_PROXY_MODE=1
DIETER_PUBLIC_URL=https://dieter.example.com
DIETER_GITHUB_CLIENT_ID=
DIETER_GITHUB_CLIENT_SECRET=
# Authorize one or more immutable numeric GitHub IDs, separated by commas.
DIETER_GITHUB_ALLOWED_USER_IDS=
# Generate with: openssl rand -hex 32
DIETER_AUTH_SECRET=
DIETER_NATIVE_SESSION_TTL=720h
# Exact custom-scheme callbacks used by the official native clients.
DIETER_NATIVE_REDIRECT_URIS=dieter-mac://oauth/callback,dieter-android://oauth/callback
# Optional screen-sharing and data-control ICE configuration. In production,
# expose TURN on UDP/TCP 3478 plus TURN/TLS on TCP 443 so restrictive networks
# have a TLS egress path. The gateway issues only short-lived credentials; the
# TURN listeners themselves are provisioned separately.
DIETER_RTC_STUN_URLS=
# DIETER_RTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
DIETER_RTC_TURN_URLS=
DIETER_RTC_TTL=5m
# Generate with: openssl rand -hex 32
DIETER_RTC_TURN_SECRET=
# If the gateway terminates TLS itself, disable proxy mode and provide both:
# DIETER_GATEWAY_TLS_CERT=/path/to/fullchain.pem
# DIETER_GATEWAY_TLS_KEY=/path/to/private-key.pem

# When using deploy/gateway, turnSharedSecret is canonical printable UTF-8 text.
# The renderer derives DIETER_RTC_TURN_SECRET by hex-encoding those exact bytes;
# coturn receives the text itself. Preserve existing credential bytes on rollout.
