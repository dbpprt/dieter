# Generated code: collapsed in diffs and excluded from language statistics.
# Regenerate with `just generate`; CI fails when these drift from their sources.
internal/gen/** linguist-generated=true
apps/apple/DieterKit/Sources/DieterAPI/Generated/** linguist-generated=true
apps/apple/DieterKit/Sources/DieterAPIGRPC/*.grpc.swift linguist-generated=true
internal/platform/buildinfo/identity.go linguist-generated=true
site/content/docs/reference/cli.md linguist-generated=true

# Preserve the imported packages' formatting; local changes are documented in
# each package's PATCHES.md.
third_party/** linguist-vendored=true
third_party/swift-markdown-engine/** -whitespace
