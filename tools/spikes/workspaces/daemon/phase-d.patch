@@ -0,0 +1,7 @@
+package workspace
+
+import "golang.org/x/sys/unix"
+
+func spikeClone(src, dst string) error {
+	return unix.Clonefile(src, dst, unix.CLONE_NOFOLLOW|unix.CLONE_NOOWNERCOPY)
+}
