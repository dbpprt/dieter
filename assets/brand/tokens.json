{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "Dieter",
    "palette": "Arctic Console",
    "slug": "arctic-console"
  },
  "brand": {
    "color": {
      "dark": {
        "$type": "color",
        "$value": "#0D1B24"
      },
      "dark-raised": {
        "$type": "color",
        "$value": "#193A49"
      },
      "shell-start": {
        "$type": "color",
        "$value": "#8DD8E8"
      },
      "shell-end": {
        "$type": "color",
        "$value": "#3D6E85"
      },
      "pane-start": {
        "$type": "color",
        "$value": "#D7F2F5"
      },
      "pane-end": {
        "$type": "color",
        "$value": "#62B6CB"
      },
      "eyes": {
        "$type": "color",
        "$value": "#BCEAF1"
      },
      "light": {
        "$type": "color",
        "$value": "#F5FBFD"
      }
    },
    "typography": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Sora",
          "Avenir Next",
          "sans-serif"
        ]
      },
      "display-weight": {
        "$type": "fontWeight",
        "$value": 700
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "monospace"
        ]
      }
    }
  },
  "semantic": {
    "light": {
      "background": {
        "$type": "color",
        "$value": "#F5FBFD"
      },
      "text": {
        "$type": "color",
        "$value": "#0D1B24"
      },
      "primary": {
        "$type": "color",
        "$value": "#0D1B24"
      },
      "accent": {
        "$type": "color",
        "$value": "#3D6E85"
      }
    },
    "dark": {
      "background": {
        "$type": "color",
        "$value": "#081116"
      },
      "surface": {
        "$type": "color",
        "$value": "#122834"
      },
      "text": {
        "$type": "color",
        "$value": "#F5FBFD"
      },
      "primary": {
        "$type": "color",
        "$value": "#8DD8E8"
      },
      "accent": {
        "$type": "color",
        "$value": "#BCEAF1"
      }
    }
  }
}
