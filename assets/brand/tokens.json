{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "color": {
      "abyss": { "$type": "color", "$value": "#071426" },
      "deep-current": { "$type": "color", "$value": "#0B1F3A" },
      "cobalt": { "$type": "color", "$value": "#2563EB" },
      "aegean": { "$type": "color", "$value": "#22D3EE" },
      "seafoam": { "$type": "color", "$value": "#5EEAD4" },
      "foam": { "$type": "color", "$value": "#F7FAFC" },
      "mist": { "$type": "color", "$value": "#EAF2F8" },
      "slate": { "$type": "color", "$value": "#526174" },
      "coral": { "$type": "color", "$value": "#FB7185" },
      "amber": { "$type": "color", "$value": "#F59E0B" }
    },
    "typography": {
      "display": { "$type": "fontFamily", "$value": ["Sora", "Avenir Next", "sans-serif"] },
      "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "SFMono-Regular", "monospace"] }
    },
    "radius": {
      "small": { "$type": "dimension", "$value": "8px" },
      "medium": { "$type": "dimension", "$value": "14px" },
      "large": { "$type": "dimension", "$value": "22px" },
      "xlarge": { "$type": "dimension", "$value": "32px" }
    }
  },
  "semantic": {
    "light": {
      "background": { "$type": "color", "$value": "{brand.color.foam}" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "text": { "$type": "color", "$value": "{brand.color.abyss}" },
      "text-muted": { "$type": "color", "$value": "{brand.color.slate}" },
      "border": { "$type": "color", "$value": "#D8E4EE" },
      "primary": { "$type": "color", "$value": "#155EEF" },
      "accent": { "$type": "color", "$value": "#0F91A8" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "#050B14" },
      "surface": { "$type": "color", "$value": "#0B1628" },
      "surface-raised": { "$type": "color", "$value": "#12243C" },
      "text": { "$type": "color", "$value": "#F5FAFF" },
      "text-muted": { "$type": "color", "$value": "#9DB0C3" },
      "border": { "$type": "color", "$value": "#20364F" },
      "primary": { "$type": "color", "$value": "#56C7FF" },
      "accent": { "$type": "color", "$value": "{brand.color.seafoam}" }
    }
  }
}
