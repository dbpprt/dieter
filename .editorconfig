root = true

[*]
charset = utf-8
insert_final_newline = true

[*.go]
indent_style = tab
indent_size = tab

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.swift]
indent_style = space
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{js,mjs,css,json,yaml,yml,html,webmanifest,rb}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.sh]
indent_style = space
indent_size = 4
