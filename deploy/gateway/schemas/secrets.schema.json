{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected gateway secrets v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["githubClientID", "githubClientSecret", "authSecret", "turnSharedSecret"],
  "dependentRequired": {
    "apnsKeyBase64": ["apnsKeyID", "apnsTeamID"],
    "apnsKeyID": ["apnsKeyBase64", "apnsTeamID"],
    "apnsTeamID": ["apnsKeyBase64", "apnsKeyID"]
  },
  "properties": {
    "apnsKeyBase64": {
      "type": "string",
      "minLength": 32,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "apnsKeyID": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
    "apnsTeamID": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
    "githubClientID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "githubClientSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "authSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "turnSharedSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
