{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected gateway secrets v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "githubClientID",
    "githubClientSecret",
    "authSecret",
    "turnSharedSecret"
  ],
  "properties": {
    "githubClientID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "githubClientSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "authSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "turnSharedSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
